<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Defaults = lowest supported for pack/local builds.
      CI overrides via -p:LinqToDbVersion / -p:FireboltSdkVersion.
      Materialized CTE is compiled only when LinqToDbVersion >= 6.3.0 (see Directory.Build.Props).
    -->
    <FireboltSdkVersion Condition="'$(FireboltSdkVersion)' == ''">1.10.1</FireboltSdkVersion>
    <LinqToDbVersion Condition="'$(LinqToDbVersion)' == ''">6.0.0</LinqToDbVersion>
    <!--
      Two nupkg lines (same package id):
      * compiled against 6.0.0 → linq2db [6.0.0, 6.4.0)
      * compiled against 6.4.0 → linq2db [6.4.0, )
      Restore still uses the single LinqToDbVersion above; pack rewrites the nuspec range.
    -->
    <LinqToDbDependencyRange Condition="'$(LinqToDbDependencyRange)' == '' AND $([MSBuild]::VersionLessThan('$(LinqToDbVersion)', '6.4.0'))">[6.0.0, 6.4.0)</LinqToDbDependencyRange>
    <LinqToDbDependencyRange Condition="'$(LinqToDbDependencyRange)' == ''">[6.4.0, )</LinqToDbDependencyRange>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build / analyzers -->
    <PackageVersion Include="MinVer" Version="5.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <!-- Test stack -->
    <PackageVersion Include="xunit.v3" Version="3.1.0" />
    <PackageVersion Include="xunit.v3.assert" Version="3.1.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5"/>

    <PackageVersion Include="Xunit.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <!-- LinqToDb -->
    <PackageVersion Include="linq2db" Version="$(LinqToDbVersion)" />
    <!-- Firebolt -->
    <PackageVersion Include="FireboltNetSDK" Version="$(FireboltSdkVersion)" />
  </ItemGroup>

  <!-- After LinqToDbVersion is known (incl. -p: override and defaults above). -->
  <PropertyGroup>
    <LinqToDbHasMaterializedCte>false</LinqToDbHasMaterializedCte>
    <LinqToDbHasMaterializedCte Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(LinqToDbVersion)', '6.3.0'))">true</LinqToDbHasMaterializedCte>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LinqToDbHasMaterializedCte)' == 'true'">
    <DefineConstants>$(DefineConstants);LINQ2DB_HAS_MATERIALIZED_CTE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(LinqToDbVersion)', '6.4.0'))">
    <DefineConstants>$(DefineConstants);LINQ2DB_6_4_LINE</DefineConstants>
  </PropertyGroup>
</Project>
